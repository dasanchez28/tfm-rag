# ============================================================
#  Environment variables: copy this file to ".env" and fill it in.
#  ".env" is git-ignored: never commit your API key.
# ============================================================

# --- Generator LLM provider (external API) ---
# Supported values: "anthropic" | "openai"
LLM_PROVIDER=anthropic

# API key (fill in only the one for the selected provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Generator model. Model used in the reported experiments:
#   anthropic: claude-haiku-4-5-20251001
# Alternative:
#   openai:    gpt-4o-mini
LLM_MODEL=claude-haiku-4-5-20251001

# Low temperature to favour faithfulness
LLM_TEMPERATURE=0.1

# Maximum output tokens (a generous value avoids truncated RAGAS judgements)
LLM_MAX_TOKENS=4096

# --- Embeddings ---
# "local"  uses sentence-transformers (free, runs on CPU)
# "openai" uses the OpenAI embeddings API
#          (set EMBEDDINGS_MODEL accordingly, e.g. text-embedding-3-small)
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Random seed for reproducibility ---
RANDOM_SEED=42
